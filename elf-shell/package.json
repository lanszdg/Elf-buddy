{
  "name": "elf-shell",
  "private": true,
  "version": "0.1.0",
  "description": "Elf Buddy 桌宠壳（Electron + Vue3，docs/03 §1）",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.elfbuddy.app",
    "productName": "Elf Buddy",
    "directories": {
      "output": "release-new"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "../elf-brain/dist/elf-brain.exe",
        "to": "brain/elf-brain.exe"
      },
      {
        "from": "models",
        "to": "models"
      }
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "ElfBuddy-portable-${version}.exe"
    }
  },
  "dependencies": {
    "onnxruntime-web": "1.18.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.1.10"
  }
}
